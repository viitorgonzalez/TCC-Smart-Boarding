# Ambiente LOCAL. Copie para `.env` e preencha o que estiver como CHANGE_ME.
# O `.env` e gitignored — nunca commite.
#
#   cp .env.example .env
#   docker compose up -d
#   ./run-local.sh

# ── Banco ─────────────────────────────────────────────────────────────────────
DB_NAME=smartboarding_db
DB_USER=admin
DB_PASSWORD=CHANGE_ME_senha_forte

# Host e porta tem default no application.properties (localhost:5433, que e o
# que o docker-compose expoe). So preencha se mudar o compose.
# DB_HOST=localhost
# DB_PORT=5433

# ── pgAdmin (so o compose usa) ────────────────────────────────────────────────
PGADMIN_EMAIL=CHANGE_ME_seu@email.com
PGADMIN_PASSWORD=CHANGE_ME_senha_forte

# ── Seguranca ─────────────────────────────────────────────────────────────────
# MINIMO 32 caracteres — mais curto derruba a aplicacao no BOOT, e o erro nao
# aponta pra ca. Gere com:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_bytes_use_openssl_rand_hex_32

# ── Firebase / FCM (opcional) ─────────────────────────────────────────────────
# Caminho do service account JSON. Vazio ou ausente = push desabilitado e a
# aplicacao sobe normalmente. Ver docs/firebase-setup.md no app.
FIREBASE_CREDENTIALS_PATH=

# ── Servidor ──────────────────────────────────────────────────────────────────
# PORT=8080
