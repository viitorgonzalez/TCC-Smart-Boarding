# Ambiente de PRODUCAO — referencia do que precisa existir no provedor.
#
# NAO crie um `.env.prod` nesta maquina com valores reais. Estas variaveis vao
# no painel de secrets do provedor (Render/Railway/Fly/etc). Este arquivo
# existe so pra ninguem descobrir uma variavel faltando em producao.

# ── Perfil ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Banco ─────────────────────────────────────────────────────────────────────
# Duas formas. Se o provedor entrega a URL pronta, use SO a de cima — o Spring
# da precedencia a ela e ignora host/porta/nome separados.
#
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
#
# Caso contrario, preencha as partes:
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Postgres gerenciado costuma EXIGIR TLS. Sem sslmode=require a conexao e
# recusada — e a mensagem raramente diz que o motivo e esse.

# Conexoes do pool. Plano gratuito costuma limitar a ~20 no total; o default
# do Hikari (10) por instancia estoura rapido com mais de uma instancia.
DB_POOL_MAX=5

# ── Seguranca ─────────────────────────────────────────────────────────────────
# DIFERENTE do segredo de desenvolvimento. Gere:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# ── Firebase / FCM ────────────────────────────────────────────────────────────
# Caminho de um arquivo dentro do container. Como o service account e um JSON
# e nao uma string simples, a forma usual e montar como secret file no provedor
# e apontar o caminho aqui. Vazio = push desabilitado.
FIREBASE_CREDENTIALS_PATH=

# ── Servidor ──────────────────────────────────────────────────────────────────
# Injetado automaticamente pela maioria dos provedores. So preencha se o seu nao injeta.
# PORT=8080

# ── JVM (opcional) ────────────────────────────────────────────────────────────
# Container pequeno: limite a heap pra JVM nao ser morta por OOM do orquestrador.
# JAVA_OPTS=-XX:MaxRAMPercentage=75
