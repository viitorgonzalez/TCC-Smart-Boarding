# Copie pra .env e preencha. Só este arquivo é versionado.

# ─── Banco ───────────────────────────────────────────────────────────────────
DB_NAME=smartboarding_db
DB_USER=admin
DB_PASSWORD=CHANGE_ME_senha_forte
# Default localhost:5433, que é o que o docker-compose expõe.
# DB_HOST=localhost
# DB_PORT=5433
# DB_POOL_MAX=5

PGADMIN_EMAIL=CHANGE_ME_seu@email.com
PGADMIN_PASSWORD=CHANGE_ME_senha_forte

# ─── Sessão ──────────────────────────────────────────────────────────────────
# MÍNIMO 32 caracteres — mais curto derruba a aplicação no BOOT e o erro não
# aponta pra cá. Gere com: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_min_32_bytes_use_openssl_rand_hex_32

# Client ID **Web** do Google (o mesmo que o app passa em GOOGLE_WEB_CLIENT_ID).
# Vazio desabilita o login com Google; a API recusa o token em vez de aceitar
# qualquer um.
GOOGLE_CLIENT_ID=

# ─── E-mail (recuperação de senha) ───────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME_resend_api_key
RESEND_FROM_EMAIL=CHANGE_ME_email_de_dominio_verificado_no_resend
# PASSWORD_RESET_TTL_MINUTES=15
# PASSWORD_RESET_MAX_ATTEMPTS=5
# PASSWORD_RESET_COOLDOWN_SECONDS=60

# ─── Código de rota ──────────────────────────────────────────────────────────
# ROUTE_INVITE_CODE_LENGTH=6
# ROUTE_INVITE_VALIDITY_DAYS=90

# ─── Push (opcional) ─────────────────────────────────────────────────────────
# Caminho do service account JSON. Vazio = push desabilitado e a aplicação sobe
# normalmente. Ver docs/firebase-setup.md no app.
FIREBASE_CREDENTIALS_PATH=

# ─── Armazenamento de arquivos (Cloudflare R2) ───────────────────────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
# URL pública do bucket: domínio custom ou o pub-<hash>.r2.dev que o Cloudflare
# gera ao habilitar acesso público. Não é derivável do account id.
R2_PUBLIC_BASE_URL=CHANGE_ME

# ─── Só em produção ──────────────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod
# PORT=8080                     # a maioria dos provedores injeta sozinho
# APP_TIMEZONE=America/Sao_Paulo
