.worktrees/

# Credenciais do Firebase — nunca versionadas. O google-services.json ja e
# ignorado pelo .gitignore do app; o service account da API e a chave mais
# sensivel das duas e faltava regra.
**/firebase-service-account*.json
**/GoogleService-Info.plist

# Backup de .env tem credencial REAL, igual ao original. O padrao .env existente
# nao cobre sufixo, e um `git add -A` leva o arquivo junto sem avisar -- foi o
# que quase aconteceu ao remover o fluxo de convite.
.env.bak*
*.env.bak*
.env.*.bak

# Config de build local do app: guarda o client ID do Google da maquina/projeto.
# Nao e segredo, mas varia por ambiente e por isso nao entra no repo.
smartboarding_app/dart_defines.local.json
